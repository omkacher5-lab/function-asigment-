#include <stdio.h>
int main(){
    int n,sum = 0;
    printf("entre the score up to 20th question \n" );
        for(int i =1;i<=20;i++){
        printf("entre the score of %d th question\n ", i );
        scanf("%d",&n);
        if(i==0) 
            continue;
        else if(i==-1) break;
        else sum+=n;
        }
    printf("total score is %d", sum);
}
