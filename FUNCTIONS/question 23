#include <stdio.h>
#include <math.h> // Required for sqrt() function

float area(float l, float b) {
    return l * b;
}

float perimeter(float l, float b) {
    return 2 * (l + b);
}

float diagonal(float l, float b) {
    return sqrt((l * l) + (b * b));
}

int main() {
    float length, breadth;
    int choice;
    printf("Enter length of the rectangle: ");
    scanf("%f", &length);
    printf("Enter breadth of the rectangle: ");
    scanf("%f", &breadth);

    // Menu display
    printf("\n--- MENU ---\n");
    printf("1. Calculate Area\n");
    printf("2. Calculate Perimeter\n");
    printf("3. Calculate Diagonal\n");
    printf("Enter your choice (1-3): ");
    scanf("%d", &choice);

    // Switch statement to select the function
    switch (choice) {
        function_selection:
        case 1:
            printf("Area of the rectangle = %.2f\n", area(length, breadth));
            break;
        case 2:
            printf("Perimeter of the rectangle = %.2f\n", perimeter(length, breadth));
            break;
        case 3:
            printf("Diagonal of the rectangle = %.2f\n", diagonal(length, breadth));
            break;
        default:
            printf("Invalid choice! Please select between 1 and 3.\n");
    }

    return 0;
}
