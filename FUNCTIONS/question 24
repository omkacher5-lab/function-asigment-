#include <stdio.h>

void printCenteredPattern(void) {
    int i = 5;
    while (i >= 1) {
        // Print leading spaces for center alignment
        int space = 1;
        while (space <= (i - 1)) {
            printf(" ");
            space++;
        }
        
        // Print the repeating numbers
        int j = 1;
        int count = 5 - i + 1;
        while (j <= count) {
            printf("%d", i);
            j++;
        }
        
        printf("\n");
        i--;
    }
}

int main() {
    printCenteredPattern();
    return 0;
}
