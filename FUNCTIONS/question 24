#include <stdio.h>

void printCenteredPattern(void) {
    for (int i = 5; i >= 1; i--) {
      for (int space = 1; space <= (i - 1); space++) {
            printf(" ");
        }

        int count = 5 - i + 1;
        for (int j = 1; j <= count; j++) {
            printf("%d", i);
        }
        printf("\n");
    }
}

int main() {
    printCenteredPattern();
    return 0;
}
