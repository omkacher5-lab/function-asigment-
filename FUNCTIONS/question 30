#include <stdio.h>

int main() {
    int rows = 5;
    for (int i = 1; i <= rows; i++) {
        for (int s = 0; s < (rows - i); s++) {
            printf("  ");
        }
        
        for (int j = 2 * i - 1; j > 0; j -= 2) {
            printf("%d ", j);
        }
        
        printf("\n");
    }

 return 0;
}
