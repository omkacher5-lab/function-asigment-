#include <stdio.h>

void calculateShoppingcart(void) {
    float price, total = 0;
    printf("Enter item prices (Enter 0 to stop, negative numbers will be ignored):\n");
    while (1) {
        printf("Enter price: ");
        scanf("%f", &price);
        if (price == 0) {
            break; // Stop on zero
        }
        if (price < 0) {
            printf("Negative price ignored.\n");
            continue; 
        } total += price;
    printf("Total shopping cart amount = %.2f\n", total);
}

int main() {
    calculateShoppingcart();
    return 0;
}
